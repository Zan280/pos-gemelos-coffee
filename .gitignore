# ==============================================================================
# Gemelos Coffee POS - .gitignore (Public Portfolio Showcase)
# ==============================================================================

# 1. Variables de entorno y secretos (Permitir plantillas .example)
.env
.env.*
*.env
!.env.example
!app/frontend/.env.example
!app/backend/.env.example

# 2. Python y Django
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
env/
venv/
ENV/
.env/
.venv/
*.sqlite3
db.sqlite3

# 3. Frontend & Node.js
node_modules/
**/node_modules/
build/
app/frontend/build/
dist/
app/frontend/dist/
.pnp/
.pnp.js
.cache/
app/frontend/.cache/

# 4. Logs y depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 5. Respaldos y archivos temporales
*.save
Dockerfile.save
codigo_gemelos.txt
**/codigo_gemelos.txt
*.zip
*.tar.gz
*.rar
*.bak
*.swp
*.swo
*~

# 6. Sistema Operativo y Editores / IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
