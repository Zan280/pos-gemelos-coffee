# ==========================================
# Gemelos Coffee POS - .gitignore
# ==========================================

# 1. Datos y persistencia local (MySQL, SQLite, Media)
data/
data/**
*.sql
*.sqlite3
db.sqlite3
media/
app/backend/media/
app/backend/data/

# 2. Secretos, variables de entorno y archivos de ejemplo
.env
.env.*
*.env
.env-example
.env.example
*.env-example
*.env.example
app/backend/.env
app/backend/.env.example
app/backend/.env-example
app/frontend/.env
app/frontend/.env.example
app/frontend/.env-example

# 3. Dependencias (Node.js & Python)
node_modules/
app/frontend/node_modules/
app/backend/node_modules/
env/
venv/
ENV/
.env/
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# 4. Compilaciones, artefactos y archivos temporales
build/
app/frontend/build/
dist/
app/frontend/dist/
.cache/
app/frontend/.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.zip
*.tar.gz
*.rar
codigo_gemelos.txt
**/codigo_gemelos.txt
Dockerfile.save
*.save

# 5. Sistema operativo y editores / IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
