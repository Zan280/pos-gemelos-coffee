# ==============================================================================
# CONFIGURACIÓN GENERAL Y ENTORNO
# ==============================================================================
DEBUG=False
SECRET_KEY=django-insecure-change-this-in-production-example-key-123456

# Hosts permitidos y orígenes CSRF (separados por comas)
ALLOWED_HOSTS=127.0.0.1,localhost,gemelos_backend
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# BASE DE DATOS (MySQL)
# ==============================================================================
DATABASE=mysql
SQL_ENGINE=django.db.backends.mysql
SQL_HOST=db
SQL_PORT=3306
SQL_DATABASE=pos_database
SQL_USER=pos_user
SQL_PASSWORD=your_secure_user_password_here
SQL_ROOT_PASSWORD=your_secure_root_password_here

# ==============================================================================
# FRONTEND Y PUERTOS
# ==============================================================================
REACT_APP_API_BASE_URL=/api
REACT_APP_MEDIA_BASE_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=80
